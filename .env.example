# Salin ke .env lalu isi nilainya. JANGAN commit .env — berisi rahasia.

# Database — pilih salah satu:
# SQLite lokal (dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Neon/Supabase/Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
# MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<db_username>:<password>@ferz.bj80suv.mongodb.net/?appName=ferz"

# Kunci penandatangan JWT. Hasilkan dengan: openssl rand -base64 32
AUTH_SECRET=""

# NextAuth v5 beta menolak start tanpa ini.
AUTH_TRUST_HOST=true

# URL callback auth untuk pengembangan lokal.
NEXTAUTH_URL="http://localhost:3000"

# URL kanonik publik — dipakai metadata, Open Graph, JSON-LD, sitemap, robots.txt.
# WAJIB diisi di produksi; tanpa ini semua metadata menunjuk localhost.
# Jangan pakai VERCEL_URL: nilainya berubah setiap deployment preview.
# NEXT_PUBLIC_SITE_URL="https://servislokal.id"
